[TEMPLATE]
# ============================================================
# Naivolabs website — environment variables
# ============================================================
#
# All of these are BUILD-TIME values: Vite inlines them into the bundle, so
# changing one requires a rebuild and a redeploy. Copy to `.env` (gitignored).

# ---- Contact-form delivery -------------------------------------------------
# Where a contact-form submission is POSTed as JSON:
#   { name, email, budget, message }
#
# Point it at a small serverless function (Vercel, Cloudflare Worker) that holds
# your email provider's SECRET key and sends the mail. Required for Resend,
# Postmark and similar providers: their keys must never reach the browser.
#
#   VITE_INQUIRY_ENDPOINT=https://<your-function>/api/contact
#
# Or, for a form-endpoint service designed to be called from a static page with
# a PUBLIC key, set both. The key is sent as `access_key` on the body:
#
#   VITE_INQUIRY_ENDPOINT=https://api.web3forms.com/submit
#   VITE_INQUIRY_ACCESS_KEY=<public-form-key>
#
# Leave UNSET when a Payload CMS is configured below — the form then posts to
# the CMS instead. With neither set, the form refuses the submission and shows
# its email fallback rather than reporting a false success.
#
# VITE_INQUIRY_ENDPOINT=
# VITE_INQUIRY_ACCESS_KEY=

# ---- Optional: Payload CMS ------------------------------------------------
# Points the site at the Payload CMS REST API so blog posts, contact details and
# FAQs sync from the admin panel to the site (no redeploy after an edit).
#
# The CMS needs a Node.js runtime and a Postgres database. It cannot run on the
# shared nginx host (no Node.js, no systemd access, MariaDB only) — see
# deploy/SHARED-HOST-DEPLOY.md.
#
# Local dev (cms/ on port 3100):
#   VITE_CMS_URL=http://localhost:3100
#
# Hosted elsewhere:
#   VITE_CMS_URL=https://cms.naivolabs.com
#
# VITE_CMS_URL=
