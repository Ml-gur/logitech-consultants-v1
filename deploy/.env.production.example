# ============================================================
# Naivolabs — production environment (Hetzner docker compose)
# ============================================================
# Copy to deploy/.env and fill in. NEVER commit the filled-in file:
#   cp .env.production.example .env && chmod 600 .env
#
# Generate the secrets:
#   openssl rand -base64 48        # PAYLOAD_SECRET
#   openssl rand -hex 24           # POSTGRES_PASSWORD

# ---- Domains --------------------------------------------------------------
# Point both A (and AAAA if you have IPv6) records at the server's IP BEFORE
# the first `docker compose up` — Caddy requests certificates on first request
# and Let's Encrypt needs the names to resolve.
SITE_DOMAIN=naivolabs.com
CMS_DOMAIN=cms.naivolabs.com
# Let's Encrypt expiry warnings go here.
ACME_EMAIL=operator@naivolabs.com

# ---- Site build -----------------------------------------------------------
# Baked in at image build time (Vite requirement). Point it at the CMS host so
# published content syncs without a redeploy. Leave empty for static mode.
VITE_CMS_URL=https://cms.naivolabs.com

# ---- CMS ------------------------------------------------------------------
PAYLOAD_SECRET=replace-with-openssl-rand-base64-48
# Origins allowed to call the CMS API and POST the contact form.
CORS_ORIGINS=https://naivolabs.com,https://www.naivolabs.com
# First admin user created by `npm run seed` (run once, then change the password
# in the admin panel).
SEED_ADMIN_EMAIL=admin@naivolabs.com
SEED_ADMIN_PASSWORD=replace-before-seeding

# ---- Database -------------------------------------------------------------
POSTGRES_USER=naivolabs
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
POSTGRES_DB=naivolabs
# `db` is the compose service name; the browser never sees this string.
DATABASE_URL=postgres://naivolabs:replace-with-openssl-rand-hex-24@db:5432/naivolabs

# ---- Operations -----------------------------------------------------------
# Tag images per release so a rollback is `IMAGE_TAG=<previous> docker compose up -d`.
IMAGE_TAG=2026.09.21
BACKUP_KEEP_DAYS=14
# Optional: restrict the CMS /admin surface to these CIDRs in Caddyfile.
# ADMIN_ALLOWED_IPS=127.0.0.1/32
