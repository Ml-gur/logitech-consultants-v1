# Naivolabs static site — multi-stage build.
#
#   build stage  : npm ci + vite build (VITE_CMS_URL baked in at build time)
#   serve stage  : nginx:alpine with the compiled output and a tuned config
#
# Build context is the REPOSITORY ROOT (not deploy/), because the site source
# lives there:
#
#   docker build -f deploy/Dockerfile.site -t naivolabs-site .
#
# Vite inlines VITE_* variables at build time, so VITE_CMS_URL must be passed as
# a build arg — setting it at runtime has no effect. Leaving it empty ships the
# site in static mode with its bundled fallback content.

# ---- build ----------------------------------------------------------------
FROM node:22-alpine AS build

WORKDIR /app

# Install dependencies first so a source-only change reuses this layer.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_CMS_URL=""
ENV VITE_CMS_URL=$VITE_CMS_URL
# NODE_OPTIONS guards the build against OOM on a small CI runner.
ENV NODE_OPTIONS=--max-old-space-size=2048

RUN npm run build

# ---- serve ----------------------------------------------------------------
FROM nginx:1.27-alpine AS serve

# Replace the stock config with the SPA-aware one.
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/nginx.conf /etc/nginx/conf.d/naivolabs.conf
# Security headers live in a snippet because `add_header` is not inherited by a
# location that defines its own — see the file header.
COPY deploy/nginx-security-headers.conf /etc/nginx/snippets/naivolabs-security-headers.conf

# Static output. Only the compiled artifacts — no source, no node_modules.
COPY --from=build /app/dist /usr/share/nginx/html

# Drop privileges: run as the unprivileged nginx user on port 8080 so the
# container never needs to be privileged and cannot bind a root port.
RUN sed -i 's/listen 80;/listen 8080;/' /etc/nginx/conf.d/naivolabs.conf \
  && sed -i 's#^pid .*#pid /tmp/nginx.pid;#' /etc/nginx/nginx.conf \
  && sed -i 's#^user .*#user nginx;#' /etc/nginx/nginx.conf \
  && chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx \
  && touch /tmp/nginx.pid && chown nginx:nginx /tmp/nginx.pid

USER nginx
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
