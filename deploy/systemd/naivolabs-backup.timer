# Naivolabs — schedule for the off-box backup.
#
# Runs at 03:00 server time, one hour after the in-container dump at 02:15, so
# the copy always has a completed dump to move. RandomizedDelaySec keeps it
# from colliding with other nightly jobs.

[Unit]
Description=Nightly off-box backup of Naivolabs database dumps
Requires=naivolabs-backup.service

[Timer]
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=10min
# If the server was off during the window, run once at the next boot rather
# than silently skipping the day.
Persistent=true
Unit=naivolabs-backup.service

[Install]
WantedBy=timers.target
