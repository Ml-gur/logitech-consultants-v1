  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:prerender": "npx playwright install chromium && npm run build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:mobile": "playwright test --project=mobile-chromium",
    "test:e2e:visual": "playwright test e2e/visual.spec.ts",
    "test:e2e:visual:update": "playwright test e2e/visual.spec.ts --update-snapshots",
    "test:e2e:report": "playwright show-report"
  },
