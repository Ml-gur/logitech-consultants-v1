# ============================================================
# Naivolabs CMS — environment variables
# ============================================================

# ---- Local development (SQLite) -----------------------------
# SQLite needs no external service; the DB file is created at cms/cms.db
DATABASE_URL=file:./cms.db

# ---- Production -------------------------------------------------
# Hetzner (docker compose in ../deploy) — the service host name is `db`:
# DATABASE_URL=postgres://naivolabs:<password>@db:5432/naivolabs
#
# Media uploads: leave BLOB_READ_WRITE_TOKEN UNSET on Hetzner so Payload writes
# uploads to local disk, which the compose file mounts as a named volume at
# /app/media (Payload's default staticDir is the collection slug, resolved
# against the container's working directory /app). On Vercel the filesystem is
# read-only, so the Vercel Blob plugin activates when that token IS set.

# ---- Shared ------------------------------------------------
# Must be a long random string in production (min 32 chars):
#   openssl rand -base64 48
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Comma-separated origins allowed to call the public REST API and POST the
# contact form. The site origin only — never a wildcard in production.
# Local dev:  http://localhost:3000
# Production: https://naivolabs.com,https://www.naivolabs.com
CORS_ORIGINS=http://localhost:3000

# ---- Seed --------------------------------------------------
# Credentials for the first admin user created by `npm run seed`.
# CHANGE THESE and delete them from any shell history before production.
SEED_ADMIN_EMAIL=admin@naivolabs.com
SEED_ADMIN_PASSWORD=change-me-before-seeding
