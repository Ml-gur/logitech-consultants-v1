# ============================================================
# Logitech Consultants CMS - environment variables
# ============================================================

# ---- Local development (SQLite) -----------------------------
# SQLite needs no external service; the DB file is created at cms/cms.db
DATABASE_URL=file:./cms.db

# ---- Production (Vercel) ------------------------------------
# Use a serverless Postgres (e.g. Neon). Uncomment on Vercel:
# DATABASE_URL=postgres://user:pass@host/db
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx   # media uploads -> Vercel Blob

# ---- Shared ------------------------------------------------
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Comma-separated origins allowed to call the public REST API + form POST.
# Local dev site is http://localhost:3000 (Vite dev server).
# Production: add your site's https:// domain, e.g. https://logitechconsultants.com
CORS_ORIGINS=http://localhost:3000
